generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum MessageCategory {
  SALES
  SUPPORT
  PROMOTIONS
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum DealType {
  DAILY
  WEEKLY
  CLEARANCE
  CEREMONY
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  OAUTH_EXCHANGE
  OAUTH_STATE
}

model AuthToken {
  id           String           @id @default(cuid())
  key          String           @unique
  code         String
  type         VerificationType
  metadata     Json?
  attemptsLeft Int              @default(5)
  sentAt       DateTime         @default(now())
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([type, expiresAt])
}

model User {
  id           String          @id @default(cuid())
  name         String?
  email        String          @unique
  passwordHash String
  phone        String?
  dob          DateTime?
  gender       String?
  role         Role            @default(CUSTOMER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  orders       Order[]
  reviews      Review[]
  cart         Cart?
  questions    Question[]
  answers      Answer[]
  addresses    Address[]
  preferences  UserPreference?
  wishlist     WishlistItem[]
  messages     InboxMessage[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  imageUrl          String?
  description       String?
  price             Decimal            @db.Decimal(12, 2)
  compareAtPrice    Decimal?           @db.Decimal(12, 2)
  discountPercent   Int?
  stock             Int                @default(0)
  status            ProductStatus      @default(DRAFT)
  dealType          DealType?
  isDealActive      Boolean            @default(false)
  dealStartAt       DateTime?
  dealEndAt         DateTime?
  isFeatured        Boolean            @default(false)
  allowBackorder    Boolean            @default(false)
  lowStockThreshold Int                @default(10)
  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  attributes        Json?              @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  reviews           Review[]
  cartItems         CartItem[]
  questions         Question[]
  wishlistItems     WishlistItem[]
  stockReservations StockReservation[]

  @@index([categoryId])
  @@index([status])
  @@index([isDealActive])
}

model Cart {
  id                String     @id @default(cuid())
  userId            String?    @unique
  user              User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken        String?    @unique
  appliedCouponCode String?
  items             CartItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  productId    String
  quantity     Int      @default(1)
  variantId    String?
  variantKey   String
  variantLabel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantKey])
  @@index([productId])
  @@index([cartId])
}

model Order {
  id               String        @id @default(cuid())
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentMethod    String?       @default("CARD")
  stripePaymentId  String?
  paymentReference String?
  totalAmount      Decimal       @db.Decimal(12, 2)
  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingZip     String?
  shippingCountry String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Review {
  id        String       @id @default(cuid())
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  userId    String
  productId String
  user      User         @relation(fields: [userId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model Question {
  id        String       @id @default(cuid())
  text      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  productId String
  user      User         @relation(fields: [userId], references: [id])
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  answers   Answer[]

  @@index([productId])
  @@index([userId])
}

model Answer {
  id         String   @id @default(cuid())
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  questionId String
  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CartRuleConfig {
  id                    String   @id @default("default")
  minCartValue          Decimal  @default(0) @db.Decimal(12, 2)
  maxQuantityPerProduct Int      @default(25)
  freeShippingThreshold Decimal  @default(1000) @db.Decimal(12, 2)
  taxRatePercent        Decimal  @default(0) @db.Decimal(5, 2)
  abandonedHours        Int      @default(24)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  updatedById           String?
}

model Address {
  id        String  @id @default(cuid())
  label     String
  line1     String
  city      String
  isDefault Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id                  String  @id @default(cuid())
  emailOrderUpdates   Boolean @default(true)
  emailWishlistAlerts Boolean @default(true)
  emailPromotions     Boolean @default(false)
  smsAlerts           Boolean @default(false)
  pushNotifications   Boolean @default(true)
  newsletter          Boolean @default(true)
  currency            String  @default("ETB")
  language            String  @default("English")
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model InboxMessage {
  id        String          @id @default(cuid())
  sender    String
  subject   String
  body      String
  read      Boolean         @default(false)
  archived  Boolean         @default(false)
  category  MessageCategory @default(SUPPORT)
  replies   Json?           @default("[]")
  createdAt DateTime        @default(now())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model StockReservation {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?
  quantity  Int
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([productId])
  @@index([orderId])
}
